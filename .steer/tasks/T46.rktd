((id "T46")
 (title "C# structural gate: brace and string aware scanner for the hook")
 (status done)
 (priority 2)
 (goal
  "Generalise the bracket scanner to C-family lexing (// and /* */ comments, \"..\" with escapes, @verbatim, $interpolated with nested braces, raw \"\"\" strings, 'c' literals, #directives) so unclosed/mismatched braces are located with a fix in under 50 ms, without dotnet.")
