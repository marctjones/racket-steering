compiled/
build/
dist/
# sample corpora and eval sets: fetched by `make samples`, never committed
samples/
.venv-mlx/
# generated eval run artifacts (prompts/completions/results jsonl): reproducible from notes/*, large,
# and would otherwise bloat the repo; the numbers they back are written into notes/*.md
run*/
# T66/T68: any .steer/ directory the graph tests/measurement create when run directly against
# tests/fixtures/* (the fixtures themselves are checked in; the store and cache they build up while
# running tests against them in place is not) - a stray one caused a real stale-cache test failure
# once during T68 (an extractor change was invisible until the cache was deleted by hand).
tests/fixtures/**/.steer/
